    supp={https://openaccess.thecvf.com/content/ICCV2025W/Findings/supplemental/Song_Video-MMLU_A_Massive_ICCVW_2025_supplemental.pdf},
    booktitle={Proceedings of the IEEE/CVF International Conference on Computer Vision (ICCV) Workshops},
    month={October},
    year={2025},
    pages={6099-6113},
    bibtex_show={true},
    preview={video-mmlu-prev.png},
}
